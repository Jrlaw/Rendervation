#!/bin/sh
# Runs the server's tests before every commit; a failure stops the commit. Turned on per clone with
#   git config core.hooksPath .githooks
# Skip once (only when you mean to) with:  git commit --no-verify
echo "pre-commit: server tests (server/test.sh)"
if ! "$(git rev-parse --show-toplevel)/server/test.sh" -x; then
  echo "pre-commit: tests failed, nothing committed. Fix them, or see docs/backend.md." >&2
  exit 1
fi
